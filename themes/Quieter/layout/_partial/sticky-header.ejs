<button class="nav-reveal-zone" type="button" aria-label="Show navigation" aria-controls="site-navigation" aria-expanded="false"></button>
<header class="nier-nav" id="site-navigation">
	<div class="nier-pattern" aria-hidden="true"><div class="nier-pattern-inner"></div></div>
	<div class="nier-nav-inner">
		<a href="/#home" class="nier-wordmark"><span>DEVARJYA</span><small>aka Indrath // personal archive</small></a>
		<nav aria-label="Primary navigation">
			<a class="<%= name === 'home' ? 'active' : '' %>" data-section="home" href="/#home">Home</a>
			<a data-section="projects" href="/#projects">Projects</a>
			<a class="<%= name === 'archives' || name === 'post' ? 'active' : '' %>" data-section="blog" href="/archives/">Blog</a>
			<a class="<%= name === 'about' ? 'active' : '' %>" data-section="about" href="/#about">About</a>
			<a data-section="contact" href="/#contact">Contact</a>
		</nav>
	</div>
</header>
<canvas class="ascii-background" id="ascii-background" aria-hidden="true"></canvas>
<canvas id="ascii-sampler" hidden></canvas>
